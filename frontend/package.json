{
    "name": "careconnect-admin",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "node scripts/dev.mjs",
        "build": "npm run build:admin && npm run build:buyer",
        "preview": "vite preview",
        "dev:admin": "vite",
