PORT=5000
NODE_ENV=development

# Cấu hình kết nối PostgreSQL mẫu cho cả nhóm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=careconnect_db
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/careconnect_db

# Khóa ký token đăng nhập (đổi thành chuỗi ngẫu nhiên bất kỳ)
JWT_SECRET=doi_chuoi_bi_mat_nay

# Family Care: số phút chờ Bố mẹ bấm "Đã uống" trước khi báo cho Con (demo có thể đặt 1)
MISSED_ALERT_MINUTES=30

# Khóa Gemini riêng được cấp cho dự án; không ghi khóa thật vào file mẫu.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Khóa Goong Places: tra địa chỉ bằng chữ trong ô tìm kiếm. Thiếu khóa thì vẫn dùng GPS và chọn Tỉnh/Phường.
GOONG_API_KEY=

# Tùy chọn: khóa Google Maps Platform (Places API New) để hiện sao đánh giá nhà thuốc. Không có khóa thì ẩn dòng đánh giá.
GOOGLE_MAPS_API_KEY=
