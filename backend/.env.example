# Khóa Gemini riêng được cấp cho dự án; không ghi khóa thật vào file mẫu.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Khóa Goong Places: tra địa chỉ bằng chữ trong ô tìm kiếm. Thiếu khóa thì vẫn dùng GPS và chọn Tỉnh/Phường.
GOONG_API_KEY=

# Tùy chọn: khóa Google Maps Platform (Places API New) để hiện sao đánh giá nhà thuốc. Không có khóa thì ẩn dòng đánh giá.
GOOGLE_MAPS_API_KEY=
